@using Sandbox
@using Sandbox.UI
@namespace Sandbox
@inherits PanelComponent

@{
    Connection owner = ResolveOwner();
    bool isReady = IsOwnerReady();
}

<root>
    @if ( owner != null )
    {
        <div class="ready-label @(isReady ? "is-ready" : "")">@(isReady ? "Ready" : "Not Ready")</div>
        <div class="plate">
            <img class="avatar" src="avatar:@(owner.SteamId)" />
            <div class="name">@owner.DisplayName</div>
        </div>
    }
</root>

@code
{
    private Connection ResolveOwner()
    {
        GameObject player = GameObject.Parent;
        if ( player == null ) return null;

        Connection owner = player.Network?.Owner;
        if ( owner != null ) return owner;

        return !player.Network.IsProxy ? Connection.Local : null;
    }

    private bool IsOwnerReady()
    {
        PlayerReadyState state = GameObject.Parent?.Components.Get<PlayerReadyState>();
        return state != null && state.IsReady;
    }

    protected override int BuildHash()
    {
        Connection owner = GameObject.Parent?.Network?.Owner;
        return System.HashCode.Combine( owner?.Id, owner?.DisplayName, IsOwnerReady() );
    }
}
