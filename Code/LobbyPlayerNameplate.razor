@using Sandbox
@using Sandbox.UI
@namespace Sandbox
@inherits PanelComponent

@{
    Connection owner = ResolveOwner();
    bool isReady = IsOwnerReady();
    bool canKick = CanKick( owner );
}

<root>
    @if ( owner != null )
    {
        <div class="ready-label @(isReady ? "is-ready" : "")">@(isReady ? "Ready" : "Not Ready")</div>
        <div class="plate @(canKick ? "can-kick" : "")" onclick=@KickOwner>
            <div class="avatar-slot">
                <img class="avatar" src="avatar:@(owner.SteamId)" />
                @if ( canKick )
                {
                    <div class="kick-x">X</div>
                }
            </div>
            <div class="name-slot">
                <div class="name">@owner.DisplayName</div>
                @if ( canKick )
                {
                    <div class="kick-text">Kick?</div>
                }
            </div>
        </div>
    }
</root>

@code
{
    private Connection ResolveOwner()
    {
        GameObject player = GameObject.Parent;
        if ( player == null ) return null;

        Connection owner = player.Network?.Owner;
        if ( owner != null ) return owner;

        return !player.Network.IsProxy ? Connection.Local : null;
    }

    private bool CanKick( Connection owner )
    {
        return Networking.IsHost && owner != null && owner != Connection.Local;
    }

    private void KickOwner()
    {
        Connection owner = ResolveOwner();
        if ( !CanKick( owner ) )
            return;

        owner.Kick( "Kicked by the host" );
    }

    private bool IsOwnerReady()
    {
        LobbyPlayerReadyState state = GameObject.Parent?.Components.Get<LobbyPlayerReadyState>();
        return state != null && state.IsReady;
    }

    protected override int BuildHash()
    {
        Connection owner = GameObject.Parent?.Network?.Owner;
        return System.HashCode.Combine( owner?.Id, owner?.DisplayName, IsOwnerReady(), CanKick( owner ) );
    }
}
