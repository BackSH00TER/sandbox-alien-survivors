@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="title">Time: @CountdownTime</div>

	@if (LocalSurvivor.IsValid())
	{
		<div class="experience">
			<div class="fill" style="width: @(ExperiencePercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
			<div class="label">Lv @LocalSurvivor.Level</div>
		</div>

		@if (LocalSurvivor.PendingModifierChoices > 0)
		{
			var survivor = LocalSurvivor;
			var offerId = survivor.ModifierOfferId;
			<div class="modifier-picker">
				<div class="modifier-heading">Choose an upgrade</div>
				<div class="modifier-hint">Pick one - upgrades stack. Gameplay continues.</div>
				<div class="modifier-options">
					@foreach (var option in new[] { survivor.ModifierOptionOne, survivor.ModifierOptionTwo, survivor.ModifierOptionThree })
					{
						<button class="modifier-card" @onclick="@(() => survivor.SelectModifier(offerId, option))">
							<div class="modifier-name">@ModifierCatalog.Name(option)</div>
							<div class="modifier-description">@ModifierCatalog.Description(option)</div>
						</button>
					}
				</div>
				@if (survivor.PendingModifierChoices > 1)
				{
					<div class="modifier-hint">@survivor.PendingModifierChoices upgrades waiting</div>
				}
			</div>
		}
	}
</root>

@code
{
	private int CountdownTime => Scene.GetAllComponents<GameManager>().FirstOrDefault()?.CountdownTime ?? 0;

	private SurvivorController LocalSurvivor => Scene.GetAllComponents<SurvivorController>().FirstOrDefault(x => !x.IsProxy);

	private float ExperiencePercent
	{
		get
		{
			var survivor = LocalSurvivor;
			if (!survivor.IsValid())
				return 0f;

			return ((float)survivor.Experience / survivor.ExperienceToNextLevel).Clamp(0f, 1f) * 100f;
		}
	}

	protected override int BuildHash()
	{
		var survivor = LocalSurvivor;
		return System.HashCode.Combine(CountdownTime, survivor, survivor?.Level, ExperiencePercent,
			survivor?.PendingModifierChoices, survivor?.ModifierOfferId);
	}
}