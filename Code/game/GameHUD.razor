@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="title">@MatchStatus@(LocalSurvivor?.IsStunned == true ? " | STUNNED" : "")</div>

	@if (LocalSurvivor.IsValid())
	{
		<div class="modifier-inventory">
			@foreach (var modifier in System.Enum.GetValues<Modifier>())
			{
				var stacks = ModifierStacks(LocalSurvivor, modifier);
				@if (stacks > 0)
				{
					<div class="modifier-item @modifier.ToString().ToLowerInvariant()">
						<div class="modifier-icon">@ModifierCatalog.Icon(modifier)</div>
						<div class="modifier-count">@stacks</div>
					</div>
				}
			}
		</div>

		@if (DebugEnabled && LocalSurvivor.ShowAttackDebug)
		{
			<div class="attack-debug">
				<div>Weapon: @(LocalSurvivor.EquippedWeapon?.DisplayName ?? "None")</div>
				<div>Attack rate: @((LocalSurvivor.EffectiveAttackInterval > 0f ? 1f / LocalSurvivor.EffectiveAttackInterval : 0f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)) / sec</div>
					<div>Interval: @(LocalSurvivor.EffectiveAttackInterval.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)) sec</div>
						<div>Range: @(LocalSurvivor.EffectiveAttackRange.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) units</div>
							<div>Bullets / shot: @(LocalSurvivor.EquippedWeapon?.BulletsPerShot ?? 0)</div>
							<div>B: Toggle debug</div>
							<div>K: Kill self</div>
							<div>G: Spawn flare pickup</div>
							<div>H: God mode (@(LocalSurvivor.GodMode ? "ON" : "off"))</div>
						</div>
					}
					<div class="experience">
						<div class="fill"
							 style="width: @(ExperiencePercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
						<div class="label">Lv @LocalSurvivor.Level</div>
					</div>

					@if (NearbyWeapon.IsValid() && !LocalSurvivor.IsDead)
					{
						<div class="weapon-prompt">E: Replace @(LocalSurvivor.EquippedWeapon?.DisplayName ?? "weapon") with
							@NearbyWeapon.DisplayName</div>
						}

						@if (LocalSurvivor.IsDead)
						{
							<div class="dead-banner">
								<div class="dead-title">YOU DIED</div>
								<div class="dead-hint">Fly with WASD. Stay alive until a teammate fires a flare, then fly through it to return.
								</div>
							</div>
						}

						@if (_flareVisible)
						{
							<div class="flare-marker"
								 style="left: @(Percent(_flareMarkerPosition.x)); top: @(Percent(_flareMarkerPosition.y));">
								<div class="flare-arrow-icon"
									 style="transform: rotate(@(_flareArrowAngle.ToString("0", System.Globalization.CultureInfo.InvariantCulture))deg);">
									arrow_forward</div>
									<div class="flare-distance">@(_flareDistance)m</div>
								</div>
							}

							@if (LocalSurvivor.PendingModifierChoices > 0)
							{
								var survivor = LocalSurvivor;
								var offerId = survivor.ModifierOfferId;
								<div class="modifier-picker">
									<div class="modifier-heading">Choose an upgrade</div>
									<div class="modifier-hint">Press 1, 2, or 3, or click a card. Upgrades stack. Gameplay continues.</div>
									<div class="modifier-options">
										@for (var index = 0; index < 3; index++)
										{
											var option = ModifierOption(survivor, index);
											<button class="modifier-card" @onclick="@(() => survivor.SelectModifier(offerId, option))">
												<div class="modifier-key">@(index + 1)</div>
												<div class="modifier-icon">@ModifierCatalog.Icon(option)</div>
												<div class="modifier-name">@ModifierCatalog.Name(option)</div>
												<div class="modifier-description">@ModifierCatalog.Description(option)</div>
											</button>
										}
									</div>
									@if (survivor.PendingModifierChoices > 1)
									{
										<div class="modifier-hint">@survivor.PendingModifierChoices upgrades waiting</div>
									}
								</div>
							}
						}

					@if (PlayerStats.HasRoundEnded(Scene))
					{
						<GameStatsScreen />
					}
					</root>

@code
{
	public bool DebugEnabled { get; private set; } = true;

	public static bool IsDebugEnabled(Scene scene) => scene.GetAllComponents<GameHUD>().Any(x => x.DebugEnabled);

	private int CountdownTime => Scene.GetAllComponents<GameManager>().FirstOrDefault()?.RemainingSeconds ?? 0;
	private string MatchStatus
	{
		get
		{
			BossEnemy bossEnemy = Scene.GetAllComponents<BossEnemy>().FirstOrDefault();
			Enemy boss = bossEnemy.IsValid() ? bossEnemy.GetComponent<Enemy>() : null;
			if (!boss.IsValid())
				return $"Boss in: {CountdownTime}";

			return boss.Health > 0f
				? $"Boss: {boss.Health:0} / {boss.MaxHealth:0}"
				: "Boss defeated";
		}
	}

	private SurvivorController LocalSurvivor => Scene.GetAllComponents<SurvivorController>().FirstOrDefault(x =>
!x.IsProxy);
	private LootPickup NearbyWeapon => LootPickup.FindNearestWeapon(LocalSurvivor);

	// Dead players get an arrow pointing at the nearest flare: pinned to the screen edge when it is off-screen,
	// or hovering just above the flare when it is in view.
	private const float UnitsPerMeter = 40f;
	private const float MarkerEdgeX = 0.44f;
	private const float MarkerEdgeY = 0.42f;
	private bool _flareVisible;
	private Vector2 _flareMarkerPosition;
	private float _flareArrowAngle;
	private int _flareDistance;

	private static string Percent(float value) =>
		(value * 100f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

	private void UpdateFlareMarker()
	{
		_flareVisible = false;
		var survivor = LocalSurvivor;
		var camera = Scene.Camera;
		if (!survivor.IsValid() || !survivor.IsDead || !camera.IsValid())
			return;

		var flare = Scene.GetAllComponents<ReviveFlare>()
			.OrderBy(x => (x.WorldPosition - survivor.WorldPosition).LengthSquared)
			.FirstOrDefault();
		if (!flare.IsValid())
			return;

		_flareVisible = true;
		_flareDistance = (int)((flare.WorldPosition - survivor.WorldPosition).WithZ(0f).Length / UnitsPerMeter);

		var screen = camera.PointToScreenNormal(flare.WorldPosition);
		var inFront = (flare.WorldPosition - camera.WorldPosition).Dot(camera.WorldRotation.Forward) > 0f;
		var offset = new Vector2(screen.x - 0.5f, screen.y - 0.5f);
		if (!inFront)
			offset = -offset;

		var onScreen = inFront && System.MathF.Abs(offset.x) <= MarkerEdgeX && System.MathF.Abs(offset.y) <= MarkerEdgeY;
		if (onScreen)
		{
			_flareMarkerPosition = new Vector2(screen.x, screen.y - 0.07f);
			_flareArrowAngle = 90f;
			return;
		}

		var scale = System.MathF.Max(System.MathF.Abs(offset.x) / MarkerEdgeX, System.MathF.Abs(offset.y) / MarkerEdgeY);
		if (scale < 0.0001f)
			scale = 1f;

		_flareMarkerPosition = new Vector2(0.5f + offset.x / scale, 0.5f + offset.y / scale);
		_flareArrowAngle = System.MathF.Atan2(offset.y, offset.x) * 180f / System.MathF.PI;
	}

	protected override void OnUpdate()
	{
		if (Input.Pressed("ToggleDebug"))
			DebugEnabled = !DebugEnabled;

		UpdateFlareMarker();

		var survivor = LocalSurvivor;
		if (!survivor.IsValid() || survivor.PendingModifierChoices <= 0)
			return;

		for (var index = 0; index < 3; index++)
		{
			if (!Input.Pressed($"Slot{index + 1}"))
				continue;

			survivor.SelectModifier(survivor.ModifierOfferId, ModifierOption(survivor, index));
			break;
		}
	}

	private static Modifier ModifierOption(SurvivorController survivor, int index) => index switch
	{
		0 => survivor.ModifierOptionOne,
		1 => survivor.ModifierOptionTwo,
		2 => survivor.ModifierOptionThree,
		_ => throw new System.ArgumentOutOfRangeException(nameof(index))
	};

	private static int ModifierStacks(SurvivorController survivor, Modifier modifier) => modifier switch
	{
		Modifier.AttackSpeed => survivor.AttackSpeedStacks,
		Modifier.AttackRange => survivor.AttackRangeStacks,
		Modifier.Vitality => survivor.VitalityStacks,
		_ => throw new System.ArgumentOutOfRangeException(nameof(modifier))
	};

	private float ExperiencePercent
	{
		get
		{
			var survivor = LocalSurvivor;
			if (!survivor.IsValid())
				return 0f;

			return ((float)survivor.Experience / survivor.ExperienceToNextLevel).Clamp(0f, 1f) * 100f;
		}
	}

	protected override int BuildHash()
	{
		var survivor = LocalSurvivor;
		return System.HashCode.Combine(MatchStatus, survivor, survivor?.Level, ExperiencePercent,
			survivor?.PendingModifierChoices, survivor?.ModifierOfferId,
			(DebugEnabled, survivor?.ShowAttackDebug, NearbyWeapon, survivor?.IsStunned, survivor?.IsDead, survivor?.GodMode, PlayerStats.HasRoundEnded(Scene)),
System.HashCode.Combine(survivor?.EffectiveAttackInterval, survivor?.EffectiveAttackRange,
				survivor?.AttackSpeedStacks, survivor?.AttackRangeStacks, survivor?.VitalityStacks, survivor?.EquippedWeapon,
				survivor?.EquippedWeapon?.BulletsPerShot, FlareMarkerHash));
	}

	private int FlareMarkerHash => System.HashCode.Combine(_flareVisible, (int)(_flareMarkerPosition.x * 500f),
		(int)(_flareMarkerPosition.y * 500f), (int)_flareArrowAngle / 2, _flareDistance);
}