@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="title">@MatchStatus@(LocalPlayer?.IsStunned == true ? " | STUNNED" : "")</div>

	@if (LocalPlayer.IsValid())
	{
		<GameModifierInventory />

		@if (DebugEnabled && LocalPlayer.ShowAttackDebug)
		{
			<div class="attack-debug">
				<div>Weapon: @(LocalPlayer.EquippedWeapon?.DisplayName ?? "None")</div>
				<div>Attack rate: @((LocalPlayer.EffectiveAttackInterval > 0f ? 1f / LocalPlayer.EffectiveAttackInterval : 0f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)) / sec</div>
				<div>Interval: @(LocalPlayer.EffectiveAttackInterval.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)) sec</div>
				<div>Range: @(LocalPlayer.EffectiveAttackRange.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) units</div>
				<div>Bullets / shot: @(LocalPlayer.EquippedWeapon?.BulletsPerShot ?? 0)</div>
				<div>B: Toggle debug</div>
				<div>K: Kill self</div>
				<div>G: Spawn flare pickup</div>
				<div>J: Spawn armor pickup</div>
				<div>L: Spawn crate</div>
				<div>H: God mode (@(LocalPlayer.GodMode ? "ON" : "off"))</div>
			</div>
		}

		<div class="armor">Armor: @LocalPlayer.Armor</div>

		<div class="experience">
			<div class="fill"
				 style="width: @(ExperiencePercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
			<div class="label">Lv @LocalPlayer.Level</div>
		</div>

		@if (NearbyWeapon.IsValid() && !LocalPlayer.IsDead)
		{
			<div class="weapon-prompt">E: Replace @(LocalPlayer.EquippedWeapon?.DisplayName ?? "weapon") with
				@NearbyWeapon.DisplayName</div>
		}

		@if (LocalPlayer.IsDead)
		{
			<div class="dead-banner">
				<div class="dead-title">YOU DIED</div>
				<div class="dead-hint">Fly with WASD. Stay alive until a teammate fires a flare, then fly through it to return.
				</div>
			</div>
			<GameFlareMarker />
		}

		<GameModifierPicker />
	}

	@if (GamePlayerStats.HasRoundEnded(Scene))
	{
		<GameStatsScreen />
	}
</root>

@code
{
	public bool DebugEnabled { get; private set; } = true;

	public static bool IsDebugEnabled(Scene scene) => scene.GetAllComponents<GameHUD>().Any(x => x.DebugEnabled);

	private int CountdownTime => Scene.GetAllComponents<GameManager>().FirstOrDefault()?.RemainingSeconds ?? 0;
	private string MatchStatus
	{
		get
		{
			GameEnemyBoss bossEnemy = Scene.GetAllComponents<GameEnemyBoss>().FirstOrDefault();
			GameEnemy boss = bossEnemy.IsValid() ? bossEnemy.GetComponent<GameEnemy>() : null;
			if (!boss.IsValid())
				return $"Boss in: {CountdownTime}";

			return boss.Health > 0f
				? $"Boss: {boss.Health:0} / {boss.MaxHealth:0}"
				: "Boss defeated";
		}
	}

	private GamePlayer LocalPlayer => Scene.GetAllComponents<GamePlayer>().FirstOrDefault(x =>
!x.IsProxy);
	private GameLootPickup NearbyWeapon => GameLootPickup.FindNearestWeapon(LocalPlayer);

	protected override void OnUpdate()
	{
		if (Input.Pressed("ToggleDebug"))
			DebugEnabled = !DebugEnabled;
	}

	private float ExperiencePercent
	{
		get
		{
			var player = LocalPlayer;
			if (!player.IsValid())
				return 0f;

			return ((float)player.Experience / player.ExperienceToNextLevel).Clamp(0f, 1f) * 100f;
		}
	}

	protected override int BuildHash()
	{
		var player = LocalPlayer;
		return System.HashCode.Combine(MatchStatus, player, player?.Level, ExperiencePercent,
			(DebugEnabled, player?.ShowAttackDebug, NearbyWeapon, player?.IsStunned, player?.IsDead, player?.GodMode, GamePlayerStats.HasRoundEnded(Scene), player?.Armor),
			System.HashCode.Combine(player?.EffectiveAttackInterval, player?.EffectiveAttackRange,
				player?.EquippedWeapon, player?.EquippedWeapon?.BulletsPerShot));
	}
}