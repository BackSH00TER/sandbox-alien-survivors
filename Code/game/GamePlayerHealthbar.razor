@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if (_visible)
	{
		<div class="bar" style="left: @(Percent(_screenPosition.x)); top: @(Percent(_screenPosition.y));">
			<div class="fill" style="width: @(HealthPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;">
			</div>
			<div class="value">@HealthText</div>
		</div>
	}
</root>

@code
{
	[Property] public GamePlayer Player { get; set; }

	private Vector2 _screenPosition;
	private bool _visible;

	private static string Percent(float value) =>
		(value * 100f).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

	protected override void OnUpdate()
	{
		_visible = false;
		if (!Player.IsValid() || Player.IsDead || Player.IsRoundOver || !Scene.Camera.IsValid())
			return;

		var position = Player.WorldPosition + Vector3.Up * 90f;
		if ((position - Scene.Camera.WorldPosition).Dot(Scene.Camera.WorldRotation.Forward) <= 0f)
			return;

		_screenPosition = Scene.Camera.PointToScreenNormal(position);
		_visible = _screenPosition.x >= 0f && _screenPosition.x <= 1f
			&& _screenPosition.y >= 0f && _screenPosition.y <= 1f;
	}

	private float HealthPercent => Player.IsValid() && Player.MaxHealth > 0f
		? (Player.Health / Player.MaxHealth).Clamp(0f, 1f) * 100f
		: 0f;

	private string HealthText => Player.IsValid()
		? $"{Player.Health.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} / {Player.MaxHealth.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}"
		: "";

	protected override int BuildHash() => System.HashCode.Combine(
		_visible, _screenPosition, HealthPercent, HealthText);
}
