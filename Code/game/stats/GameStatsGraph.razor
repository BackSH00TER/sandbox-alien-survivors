@using Sandbox;
@using Sandbox.UI;
@using System.Globalization;
@inherits Panel
@namespace Sandbox

<root>
	<div class="filter-toolbar">
		<div class="filter-label">Stats (select any combination)</div>
		<button class="graph-button advanced-toggle @(_advanced ? "selected" : "")"
				@onclick="@(() => _advanced = !_advanced)">@(_advanced ? "Basic" : "Advanced")</button>
	</div>
	<div class="metric-filters">
		@foreach (var section in GameStatCatalog.Sections)
		{
			var rows = section.Rows.Where(row => (_advanced || IsBasicMetric(row.Key) || _metrics.Contains(row.Key))
				&& (!section.ShouldHideEmptyRows || _metrics.Contains(row.Key) || Players.Any(player => player.Get(row.Key) > 0f))).ToList();
			if (rows.Count > 0)
			{
				<div class="metric-section">
					<div class="filter-label">@(section.Title)</div>
					@foreach (var row in rows)
					{
						<button class="graph-button @(_metrics.Contains(row.Key) ? "selected" : "")"
								@onclick="@(() => ToggleMetric(row.Key))">@row.Label</button>
					}
				</div>
			}
		}
	</div>
	<div class="player-filters">
		@for (var index = 0; index < Players.Count; index++)
		{
			var player = Players[index];
			var color = PlayerColor(index);
			<button class="graph-button @(!_hidden.Contains(player) ? "selected" : "")"
					style="color: @color;" @onclick="@(() => TogglePlayer(player))">
				@player.PlayerName @(_hidden.Contains(player) ? "(hidden)" : "")
			</button>
		}
	</div>
	<div class="series-legend">
		@foreach (var series in _series)
		{
			<div class="legend-entry" style="color: @series.Color;" tooltip="@($"Read this line against the {series.Axis.Label} axis")">
				<div class="legend-swatch" style="background-color: @series.Color;"></div>
				@series.Player.PlayerName - @series.Label: @series.Points.Last().Value.ToString("0.##")
			</div>
		}
	</div>
	<div class="graph-caption">Cumulative totals / @GameStatHistory.BucketSeconds-second buckets / compatible stats share an axis</div>
	<div class="chart-scroll">
		<div class="chart" style="width: @(Number(PlotWidth + AxisPadding + 20f))px; padding-left: @(Number(AxisPadding))px;">
			<div class="plot">
				@for (var index = 0; index < _axes.Count; index++)
				{
					var axis = _axes[index];
					<div class="stat-axis" style="left: @(Number(-(_axes.Count - index) * AxisWidth))px; color: @axis.Color;">
						<div class="axis-label" tooltip="@axis.Label">@axis.Label</div>
						@for (var tick = 0; tick <= 4; tick++)
						{
							var fraction = tick / 4f;
							<div class="axis-value" style="bottom: @(Number(fraction * PlotHeight))px;">@((axis.Maximum * fraction).ToString("0.##"))</div>
						}
					</div>
				}
				@for (var tick = 0; tick <= 4; tick++)
				{
					var fraction = tick / 4f;
					<div class="grid-line" style="bottom: @(Number(fraction * PlotHeight))px;"></div>
					<div class="axis-time" style="left: @(Number(fraction * PlotWidth))px;">@FormatTime(_duration * fraction)</div>
				}
				@foreach (var series in _series)
				{
					@for (var index = 1; index < series.Points.Count; index++)
					{
						var previous = series.Points[index - 1];
						var point = series.Points[index];
						var lineStyle = LineStyle(
							previous: previous,
							point: point,
							series: series
						);
						<div class="graph-line" style="@lineStyle"></div>
					}
					@foreach (var point in series.Points)
					{
						<div class="graph-point"
							 style="left: @(Number(X(point.Seconds)))px; top: @(Number(Y(point.Value, series.Axis.Maximum)))px; background-color: @series.Color;"
							 title="@series.Player.PlayerName - @series.Label - @FormatTime(point.Seconds): @point.Value.ToString("0.##")"></div>
					}
				}
				@foreach (var moment in _moments)
				{
					<button class="moment-marker"
							style="left: @(Number(X(moment.Seconds)))px; border-color: @moment.Color;"
							title="@FormatTime(moment.Seconds) - @moment.Label"
							@onclick="@(() => _selectedMoment = moment)"></button>
				}
				@if (_selectedMoment != null)
				{
					<div class="selected-marker" style="left: @(Number(X(_selectedMoment.Seconds)))px;"></div>
				}
				<div class="upgrade-overlays" style="height: @(Number(_upgradeLanes * UpgradeSpacing))px;">
					<div class="upgrade-track" style="height: @(Number(_upgradeLanes * UpgradeSpacing))px;">
						@foreach (var moment in _moments)
						{
							if (!string.IsNullOrEmpty(moment.Icon))
							{
								var iconX = UpgradeX(moment.Seconds);
								<button class="upgrade-marker"
										style="left: @(Number(iconX))px; top: @(Number(moment.Lane * UpgradeSpacing))px; color: @moment.Color; border-color: @moment.Color;"
										tooltip="@($"{FormatTime(moment.Seconds)} - {moment.Label}")"
										@onclick="@(() => _selectedMoment = moment)">
									<div class="upgrade-icon">@moment.Icon</div>
								</button>
							}
						}
					</div>
				</div>
			</div>
		</div>
	</div>
	@if (_series.Count == 0)
	{
		<div class="graph-caption">Select at least one stat and one player to show their lines.</div>
	}
	<div class="moment-controls">
		<div class="filter-label">Key moments</div>
		<button class="graph-button @(_showWorld ? "selected" : "")" @onclick="@(() => _showWorld = !_showWorld)">Bosses / events</button>
		<button class="graph-button @(_showModifiers ? "selected" : "")" @onclick="@(() => _showModifiers = !_showModifiers)">Modifiers</button>
		<button class="graph-button @(_showSurvival ? "selected" : "")" @onclick="@(() => _showSurvival = !_showSurvival)">Deaths / revives</button>
	</div>
	<div class="moment-detail">@(_selectedMoment == null ? "Click a marker or moment to inspect its exact round time." : $"{FormatTime(_selectedMoment.Seconds)} - {_selectedMoment.Label}")</div>
	<div class="moment-list">
		@foreach (var moment in _moments)
		{
			<button class="moment-entry" style="color: @moment.Color;"
					@onclick="@(() => _selectedMoment = moment)">@FormatTime(moment.Seconds) - @moment.Label</button>
		}
	</div>
</root>

@code
{
	public IReadOnlyList<GamePlayerStats> Players { get; set; } = new List<GamePlayerStats>();

	private const float PlotWidth = 760f;
	private const float PlotHeight = 240f;
	private const float UpgradeSpacing = 32f;
	private const float AxisWidth = 70f;
	private readonly HashSet<GamePlayerStats> _hidden = new();
	private readonly List<ChartSeries> _series = new();
	private readonly List<ChartMoment> _moments = new();
	private readonly List<ChartAxis> _axes = new();
	private readonly HashSet<string> _metrics = new() { GameStatKeys.DamageDealt, GameStatKeys.Kills };
	private bool _advanced;
	private bool _showWorld = true;
	private bool _showModifiers = true;
	private bool _showSurvival = true;
	private float _duration = 1f;
	private int? _contentHash;
	private ChartMoment _selectedMoment;
	private int _upgradeLanes;

	private float AxisPadding => System.MathF.Max(AxisWidth, _axes.Count * AxisWidth) + 10f;

	private sealed record ChartSeries(
		GamePlayerStats Player,
		string Color,
		List<GameStatPoint> Points,
		ChartAxis Axis,
		string Label
	);

	private sealed record ChartAxis(
		string Key,
		string Label,
		string Color
	)
	{
		public float Maximum { get; set; } = 1f;
	}

	private sealed record ChartMoment(
		float Seconds,
		string Label,
		string Color,
		string Icon
	)
	{
		public int Lane { get; init; }
	}

	private static string Number(float value)
	{
		return value.ToString("0.###", CultureInfo.InvariantCulture);
	}

	private static string FormatTime(float seconds)
	{
		var wholeSeconds = (int)seconds;
		return $"{wholeSeconds / 60}:{wholeSeconds % 60:00}";
	}

	private static string PlayerColor(int index)
	{
		var hsv = new ColorHsv(
			h: (140f + index * 137.508f) % 360f,
			s: 0.6f,
			v: 0.95f,
			a: 1f
		);
		var color = hsv.ToColor();
		return color.Hex;
	}

	private void TogglePlayer(GamePlayerStats player)
	{
		if (!_hidden.Add(player))
		{
			_hidden.Remove(player);
		}
	}

	private static bool IsBasicMetric(string key)
	{
		return key == GameStatKeys.DamageDealt || key == GameStatKeys.Kills;
	}

	private void ToggleMetric(string key)
	{
		if (!_metrics.Add(key))
		{
			_metrics.Remove(key);
		}
	}

	private static string AxisKey(string key)
	{
		if (key.StartsWith("damage_dealt") || key.StartsWith("damage_taken"))
		{
			return "Damage";
		}

		if (key == GameStatKeys.ArmorGained)
		{
			return "Armor";
		}

		return "Count";
	}

	private float X(float seconds)
	{
		return seconds / _duration * PlotWidth;
	}

	private static float Y(float value, float maximum)
	{
		return PlotHeight - value / maximum * PlotHeight;
	}

	private float UpgradeX(float seconds)
	{
		var position = X(seconds);
		return System.Math.Clamp(
			value: position,
			min: UpgradeSpacing / 2f,
			max: PlotWidth - UpgradeSpacing / 2f
		);
	}

	private string LineStyle(
		GameStatPoint previous,
		GameStatPoint point,
		ChartSeries series
	)
	{
		var deltaX = X(point.Seconds) - X(previous.Seconds);
		var previousY = Y(previous.Value, series.Axis.Maximum);
		var pointY = Y(point.Value, series.Axis.Maximum);
		var deltaY = pointY - previousY;
		var length = System.MathF.Sqrt(deltaX * deltaX + deltaY * deltaY);
		var angle = System.MathF.Atan2(deltaY, deltaX) * 180f / System.MathF.PI;
		return $"left: {Number(X(previous.Seconds))}px; top: {Number(previousY)}px; width: {Number(length)}px; transform: rotate({Number(angle)}deg); background-color: {series.Color};";
	}

	protected override int BuildHash()
	{
		var manager = Game.ActiveScene.GetAllComponents<GameManager>().FirstOrDefault();
		var hash = new System.HashCode();
		hash.Add(_advanced);
		foreach (var row in GameStatCatalog.Sections.SelectMany(section => section.Rows))
		{
			hash.Add(_metrics.Contains(row.Key));
		}
		hash.Add(_showWorld);
		hash.Add(_showModifiers);
		hash.Add(_showSurvival);
		hash.Add(_selectedMoment);
		hash.Add(manager?.ElapsedSeconds);
		hash.Add(manager?.RoundMoments.Count);
		foreach (var player in Players)
		{
			hash.Add(player);
			hash.Add(player.PlayerName);
			hash.Add(player.ContentHash());
			hash.Add(player.HistoryBuckets.Count);
			hash.Add(player.HistoryMoments.Count);
			hash.Add(player.HistoryDuration);
			hash.Add(_hidden.Contains(player));
		}

		var contentHash = hash.ToHashCode();
		if (_contentHash != contentHash)
		{
			_contentHash = contentHash;
			RebuildChart(manager);
		}

		return contentHash;
	}

	private void RebuildChart(GameManager manager)
	{
		_series.Clear();
		_moments.Clear();
		_axes.Clear();
		var duration = Players.Count > 0 ? Players.Max(player => player.HistoryDuration) : 0f;
		_duration = System.MathF.Max(1f, duration);
		var metricIndex = 0;
		foreach (var section in GameStatCatalog.Sections)
		{
			foreach (var row in section.Rows)
			{
				if (_metrics.Contains(row.Key))
				{
					var label = section.ShouldHideEmptyRows ? $"{section.Title}: {row.Label}" : row.Label;
					var axisKey = AxisKey(row.Key);
					var axis = _axes.FirstOrDefault(candidate => candidate.Key == axisKey);
					if (axis == null)
					{
						var axisColorIndex = metricIndex * System.Math.Max(1, Players.Count);
						var axisColor = PlayerColor(axisColorIndex);
						axis = new ChartAxis(
							Key: axisKey,
							Label: axisKey,
							Color: axisColor
						);
						_axes.Add(axis);
					}

					for (var playerIndex = 0; playerIndex < Players.Count; playerIndex++)
					{
						var player = Players[playerIndex];
						if (_hidden.Contains(player))
						{
							continue;
						}

						var points = GameStatHistory.BuildSeries(
							buckets: player.HistoryBuckets,
							key: row.Key,
							duration: duration
						);
						var playerMaximum = points.Max(point => point.Value);
						axis.Maximum = System.MathF.Max(axis.Maximum, playerMaximum);
						var color = PlayerColor(playerIndex + metricIndex * Players.Count);
						_series.Add(new ChartSeries(
							Player: player,
							Color: color,
							Points: points,
							Axis: axis,
							Label: label
						));
					}
				}

				metricIndex++;
			}
		}
		if (_showWorld && manager.IsValid())
		{
			foreach (var moment in manager.RoundMoments)
			{
				_moments.Add(new ChartMoment(
					Seconds: moment.Seconds,
					Label: moment.Label,
					Color: "#f5ce61",
					Icon: moment.Icon
				));
			}
		}

		for (var index = 0; index < Players.Count; index++)
		{
			var player = Players[index];
			if (_hidden.Contains(player))
			{
				continue;
			}

			var color = PlayerColor(index);
			foreach (var moment in player.HistoryMoments)
			{
				if ((moment.Kind == "modifier" && _showModifiers) || (moment.Kind == "survival" && _showSurvival))
				{
					_moments.Add(new ChartMoment(
						Seconds: moment.Seconds,
						Label: $"{player.PlayerName}: {moment.Label}",
						Color: color,
						Icon: moment.Icon
					));
				}
			}
		}

		_moments.Sort((left, right) => left.Seconds.CompareTo(right.Seconds));
		var laneEnds = new List<float>();
		for (var index = 0; index < _moments.Count; index++)
		{
			var moment = _moments[index];
			if (string.IsNullOrEmpty(moment.Icon))
			{
				continue;
			}

			var iconX = UpgradeX(moment.Seconds);
			var lane = laneEnds.FindIndex(end => iconX - end >= UpgradeSpacing);
			if (lane < 0)
			{
				lane = laneEnds.Count;
				laneEnds.Add(iconX);
			}
			else
			{
				laneEnds[lane] = iconX;
			}

			var positionedMoment = moment with { Lane = lane };
			_moments[index] = positionedMoment;
			if (_selectedMoment == moment)
			{
				_selectedMoment = positionedMoment;
			}
		}

		_upgradeLanes = laneEnds.Count;
		if (_selectedMoment != null && !_moments.Contains(_selectedMoment))
		{
			_selectedMoment = null;
		}
	}
}
