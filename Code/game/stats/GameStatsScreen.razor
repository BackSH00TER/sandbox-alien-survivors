@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	<div class="stats-panel">
		<div class="stats-title">Round Complete</div>
		@if (_roundDuration != null)
		{
			<div class="stats-duration">Time Taken: @_roundDuration</div>
		}
		<div class="stats-tabs">
			<button class="stats-button @(!_showSummary ? "selected" : "")" @onclick="@(() => _showSummary = false)">Timeline</button>
			<button class="stats-button @(_showSummary ? "selected" : "")" @onclick="@(() => _showSummary = true)">Summary</button>
		</div>
		@if (!_showSummary)
		{
			<GameStatsGraph Players="@_players" />
		}
		else
		{
			<div class="stats-grid">
				<div class="stats-row stats-header">
					<div class="stat-label"></div>
					@foreach (GamePlayerStats player in _players)
					{
						<div class="stat-value @PlayerClass(player)">@player.PlayerName</div>
					}
				</div>

				@foreach (StatSection section in GameStatCatalog.Sections)
				{
					List<StatRow> rows = VisibleRows(section);
					if (rows.Count > 0)
					{
						<div class="stats-section">@(section.Title)</div>
						@foreach (StatRow row in rows)
						{
							<div class="stats-row">
								<div class="stat-label">@row.Label</div>
								@foreach (GamePlayerStats player in _players)
								{
									<div class="stat-value @PlayerClass(player)">@player.Get(row.Key).ToString("0")</div>
								}
							</div>
						}
					}
				}
			</div>
		}
		<div class="stats-actions">
			@if (Networking.IsHost)
			{
				<button class="stats-button" @onclick="@(() => FindGameManager()?.ReturnToLobby())">Return to Lobby</button>
				<button class="stats-button" @onclick="@(() => FindGameManager()?.StartNewGame())">New Game</button>
			}
			else
			{
				<div class="stats-waiting">Waiting for the host...</div>
			}
		</div>
	</div>
</root>

@code
{
	private List<GamePlayerStats> _players = new();
	private bool _showSummary;
	private string _roundDuration;

	private static string PlayerClass(GamePlayerStats player) => player.IsProxy ? "" : "local";

	private static GameManager FindGameManager() => Game.ActiveScene.GetAllComponents<GameManager>().FirstOrDefault();

	private List<StatRow> VisibleRows(StatSection section)
	{
		if (!section.ShouldHideEmptyRows)
		{
			return section.Rows.ToList();
		}

		return section.Rows.Where(row => _players.Any(player => player.Get(row.Key) > 0f)).ToList();
	}

	// The local player comes first so their column sits next to everyone else's.
	protected override int BuildHash()
	{
		var manager = FindGameManager();
		_roundDuration = null;
		if (manager.IsValid() && manager.State == GameState.Ended)
		{
			var seconds = (int)manager.ElapsedSeconds;
			_roundDuration = $"{seconds / 60}:{seconds % 60:00}";
		}

		_players = Game.ActiveScene.GetAllComponents<GamePlayerStats>()
			.OrderBy(player => player.IsProxy)
			.ThenByDescending(player => player.Get(GameStatKeys.DamageDealt))
			.ToList();

		int hash = System.HashCode.Combine(
			value1: _players.Count,
			value2: _showSummary,
			value3: _roundDuration
		);
		foreach (GamePlayerStats player in _players)
		{
			var content = (
				player.ContentHash(),
				player.PlayerName,
				player.IsProxy,
				player.HistoryBuckets.Count,
				player.HistoryMoments.Count
			);
			hash = System.HashCode.Combine(hash, content);
		}

		return hash;
	}
}
