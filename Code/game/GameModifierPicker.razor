@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@if (_player.IsValid() && _player.PendingModifierChoices > 0)
	{
		GamePlayer player = _player;
		int offerId = player.ModifierOfferId;
		<div class="modifier-heading">Choose an upgrade</div>
		<div class="modifier-hint">Press 1-@(player.ModifierOptions.Count) or click a card. Unlock effects to roll their upgrades. Gameplay continues.</div>
		<div class="modifier-options">
			@for (int index = 0; index < player.ModifierOptions.Count; index++)
			{
				GameModifier option = player.ModifierOptions[index];
				<button class="modifier-card" @onclick="@(() => player.SelectModifier(offerId, option))">
					<div class="modifier-key">@(index + 1)</div>
					<div class="modifier-icon">@ModifierCatalog.Icon(option)</div>
					<div class="modifier-name">@ModifierCatalog.Name(option)</div>
					<div class="modifier-description">@ModifierCatalog.Description(option)</div>
				</button>
			}
		</div>
		<button class="reroll-button @(!player.CanRerollModifiers ? "unavailable" : "")"
				disabled="@(!player.CanRerollModifiers)" @onclick="@(() => player.RerollModifiers(offerId))">
			@($"R: Reroll (1 die) | {player.RerollDice} available")
		</button>
		@if (player.PendingModifierChoices > 1)
		{
			<div class="modifier-hint">@player.PendingModifierChoices upgrades waiting</div>
		}
	}
</root>

@code
{
	private GamePlayer _player;

	public override void Tick()
	{
		base.Tick();
		_player = Game.ActiveScene.GetAllComponents<GamePlayer>().FirstOrDefault(x => !x.IsProxy);
		if (!_player.IsValid() || _player.PendingModifierChoices <= 0)
		{
			return;
		}

		if (Input.Pressed("RerollModifiers") && _player.CanRerollModifiers)
		{
			_player.RerollModifiers(_player.ModifierOfferId);
			return;
		}

		for (int index = 0; index < _player.ModifierOptions.Count; index++)
		{
			if (!Input.Pressed($"Slot{index + 1}"))
			{
				continue;
			}

			_player.SelectModifier(_player.ModifierOfferId, _player.ModifierOptions[index]);
			break;
		}
	}

	protected override int BuildHash()
	{
		if (!_player.IsValid())
		{
			return 0;
		}

		int hash = System.HashCode.Combine(
			value1: _player,
			value2: _player.PendingModifierChoices,
			value3: _player.ModifierOfferId,
			value4: _player.RerollDice,
			value5: _player.CanRerollModifiers
		);
		foreach (var option in _player.ModifierOptions)
		{
			hash = System.HashCode.Combine(hash, option);
		}
		return hash;
	}
}
