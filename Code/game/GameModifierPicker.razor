@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@if (_player.IsValid() && _player.PendingModifierChoices > 0)
	{
		GamePlayer player = _player;
		int offerId = player.ModifierOfferId;
		<div class="modifier-heading">Choose an upgrade</div>
		<div class="modifier-hint">Press 1, 2, or 3, or click a card. Upgrades stack. Gameplay continues.</div>
		<div class="modifier-options">
			@for (int index = 0; index < 3; index++)
			{
				GameModifier option = ModifierOption(player, index);
				<button class="modifier-card" @onclick="@(() => player.SelectModifier(offerId, option))">
					<div class="modifier-key">@(index + 1)</div>
					<div class="modifier-icon">@ModifierCatalog.Icon(option)</div>
					<div class="modifier-name">@ModifierCatalog.Name(option)</div>
					<div class="modifier-description">@ModifierCatalog.Description(option)</div>
				</button>
			}
		</div>
		@if (player.PendingModifierChoices > 1)
		{
			<div class="modifier-hint">@player.PendingModifierChoices upgrades waiting</div>
		}
	}
</root>

@code
{
	private GamePlayer _player;

	private static GameModifier ModifierOption(GamePlayer player, int index) => index switch
	{
		0 => player.ModifierOptionOne,
		1 => player.ModifierOptionTwo,
		2 => player.ModifierOptionThree,
		_ => throw new System.ArgumentOutOfRangeException(nameof(index))
	};

	public override void Tick()
	{
		base.Tick();
		_player = Game.ActiveScene.GetAllComponents<GamePlayer>().FirstOrDefault(x => !x.IsProxy);
		if (!_player.IsValid() || _player.PendingModifierChoices <= 0)
			return;

		for (int index = 0; index < 3; index++)
		{
			if (!Input.Pressed($"Slot{index + 1}"))
				continue;

			_player.SelectModifier(_player.ModifierOfferId, ModifierOption(_player, index));
			break;
		}
	}

	protected override int BuildHash() => System.HashCode.Combine(_player,
		_player.IsValid() ? _player.PendingModifierChoices : 0,
		_player.IsValid() ? _player.ModifierOfferId : 0);
}
