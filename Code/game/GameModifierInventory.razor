@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@foreach (ModifierDefinition definition in ModifierCatalog.All)
	{
		GameModifier modifier = definition.Id;
		int stacks = StacksOf(modifier);
		if (stacks > 0)
		{
			<div class="modifier-item @(definition.EffectType.HasValue ? "damage-effect" : modifier.ToString().ToLowerInvariant())" tooltip="@($"{definition.Name}: {definition.Description}")">
				<div class="modifier-icon">@ModifierCatalog.Icon(modifier)</div>
				<div class="modifier-count">@stacks</div>
			</div>
		}
	}
</root>

@code
{
	private GamePlayer _player;

	private int StacksOf(GameModifier modifier)
	{
		if (!_player.IsValid())
		{
			return 0;
		}

		return _player.ModifierStacks(modifier);
	}

	protected override int BuildHash()
	{
		_player = Game.ActiveScene.GetAllComponents<GamePlayer>().FirstOrDefault(x => !x.IsProxy);
		if (!_player.IsValid())
		{
			return 0;
		}

		return System.HashCode.Combine(_player, _player.ModifierContentHash());
	}
}
