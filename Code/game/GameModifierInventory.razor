@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@foreach (GameModifier modifier in System.Enum.GetValues<GameModifier>())
	{
		int stacks = StacksOf(modifier);
		if (stacks > 0)
		{
			<div class="modifier-item @modifier.ToString().ToLowerInvariant()">
				<div class="modifier-icon">@ModifierCatalog.Icon(modifier)</div>
				<div class="modifier-count">@stacks</div>
			</div>
		}
	}
</root>

@code
{
	private GamePlayer _player;

	private int StacksOf(GameModifier modifier)
	{
		if (!_player.IsValid())
			return 0;

		return modifier switch
		{
			GameModifier.AttackSpeed => _player.AttackSpeedStacks,
			GameModifier.AttackRange => _player.AttackRangeStacks,
			GameModifier.Vitality => _player.VitalityStacks,
			_ => throw new System.ArgumentOutOfRangeException(nameof(modifier))
		};
	}

	protected override int BuildHash()
	{
		_player = Game.ActiveScene.GetAllComponents<GamePlayer>().FirstOrDefault(x => !x.IsProxy);
		if (!_player.IsValid())
			return 0;

		return System.HashCode.Combine(_player, _player.AttackSpeedStacks, _player.AttackRangeStacks,
			_player.VitalityStacks);
	}
}
