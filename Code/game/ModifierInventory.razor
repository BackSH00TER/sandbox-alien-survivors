@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@foreach (ModifierDefinition definition in ModifierCatalog.All)
	{
		Modifier modifier = definition.Id;
		int stacks = StacksOf(modifier);
		if (stacks > 0)
		{
			<div class="modifier-item @(definition.EffectType.HasValue ? "damage-effect" : modifier.ToString().ToLowerInvariant())" tooltip="@($"{definition.Name}: {definition.Description}")">
				<div class="modifier-icon">@ModifierCatalog.Icon(modifier)</div>
				<div class="modifier-count">@stacks</div>
			</div>
		}
	}
</root>

@code
{
	private SurvivorController _survivor;

	private int StacksOf(Modifier modifier)
	{
		if (!_survivor.IsValid())
			return 0;

		return _survivor.ModifierStacks(modifier);
	}

	protected override int BuildHash()
	{
		_survivor = Game.ActiveScene.GetAllComponents<SurvivorController>().FirstOrDefault(x => !x.IsProxy);
		if (!_survivor.IsValid())
			return 0;

		return System.HashCode.Combine(_survivor, _survivor.ModifierContentHash());
	}
}
