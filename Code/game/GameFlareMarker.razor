@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@if (_isVisible)
	{
		<div class="flare-marker"
			 style="left: @(Percent(_markerPosition.x)); top: @(Percent(_markerPosition.y));">
			<div class="flare-arrow-icon"
				 style="transform: rotate(@(_arrowAngle.ToString("0", System.Globalization.CultureInfo.InvariantCulture))deg);">
				arrow_forward</div>
			<div class="flare-distance">@(_distance)m</div>
		</div>
	}
</root>

@code
{
	// Dead players get an arrow pointing at the nearest flare: pinned to the screen edge when it is off-screen,
	// or hovering just above the flare when it is in view.
	private const float UnitsPerMeter = 40f;
	private bool _isVisible;
	private Vector2 _markerPosition;
	private float _arrowAngle;
	private int _distance;

	private static string Percent(float value) =>
		(value * 100f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

	public override void Tick()
	{
		base.Tick();
		UpdateMarker();
	}

	private void UpdateMarker()
	{
		_isVisible = false;
		Scene scene = Game.ActiveScene;
		GamePlayer player = scene.GetAllComponents<GamePlayer>().FirstOrDefault(x => !x.IsProxy);
		CameraComponent camera = scene.Camera;
		if (!player.IsValid() || !player.IsDead || !camera.IsValid())
		{
			return;
		}

		GameReviveFlare flare = scene.GetAllComponents<GameReviveFlare>()
			.OrderBy(x => (x.WorldPosition - player.WorldPosition).LengthSquared)
			.FirstOrDefault();
		if (!flare.IsValid())
		{
			return;
		}

		_isVisible = true;
		_distance = (int)((flare.WorldPosition - player.WorldPosition).WithZ(0f).Length / UnitsPerMeter);

		var marker = GameWorldMarkerPosition.Project(camera: camera, position: flare.WorldPosition);
		_markerPosition = marker.Position;
		_arrowAngle = marker.ArrowAngle;
	}

	protected override int BuildHash() => System.HashCode.Combine(
		value1: _isVisible,
		value2: (int)(_markerPosition.x * 500f),
		value3: (int)(_markerPosition.y * 500f),
		value4: (int)_arrowAngle / 2,
		value5: _distance
	);
}
