@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
	@if (_isVisible)
	{
		<div class="objective-marker @(ReviveFlare ? "flare" : "dropship")"
			 style="left: @(Percent(_markerPosition.x)); top: @(Percent(_markerPosition.y));">
			<div class="objective-arrow-icon"
				 style="transform: rotate(@(_arrowAngle.ToString("0", System.Globalization.CultureInfo.InvariantCulture))deg);">
				arrow_forward</div>
			@if (!ReviveFlare)
			{
				<div class="objective-label">@_label</div>
			}
			<div class="objective-distance">@(_distance)m</div>
		</div>
	}
</root>

@code
{
	public bool ReviveFlare { get; set; }

	private const float UnitsPerMeter = 40f;
	private const float MarkerEdgeX = 0.44f;
	private const float MarkerEdgeY = 0.42f;
	private bool _isVisible;
	private Vector2 _markerPosition;
	private float _arrowAngle;
	private int _distance;
	private string _label;

	private static string Percent(float value)
	{
		return (value * 100f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
	}

	public override void Tick()
	{
		base.Tick();
		UpdateMarker();
	}

	private void UpdateMarker()
	{
		_isVisible = false;
		Scene scene = Game.ActiveScene;
		GamePlayer player = scene.GetAllComponents<GamePlayer>().FirstOrDefault(x => !x.IsProxy);
		CameraComponent camera = scene.Camera;
		var manager = scene.GetAllComponents<GameManager>().FirstOrDefault();
		if (!player.IsValid() || player.IsDead != ReviveFlare || !camera.IsValid()
			|| (manager.IsValid() && manager.State != GameState.InProgress))
		{
			return;
		}

		Vector3 targetPosition;
		if (ReviveFlare)
		{
			var flare = scene.GetAllComponents<GameReviveFlare>()
				.OrderBy(x => (x.WorldPosition - player.WorldPosition).LengthSquared)
				.FirstOrDefault();
			if (!flare.IsValid())
			{
				return;
			}

			targetPosition = flare.WorldPosition;
		}
		else
		{
			var ship = scene.GetAllComponents<GameDropship>()
				.Where(x => x.Active && x.Health > 0f)
				.OrderBy(x => (x.GroundPosition - player.WorldPosition).LengthSquared)
				.FirstOrDefault();
			if (!ship.IsValid())
			{
				return;
			}

			targetPosition = ship.WorldPosition + Vector3.Up * 120f;
			_label = ship.Landed ? $"DROPSHIP {ship.Health:0} / {ship.MaxHealth:0}" : "DROPSHIP LANDING";
		}

		_isVisible = true;
		_distance = (int)((targetPosition - player.WorldPosition).WithZ(0f).Length / UnitsPerMeter);

		Vector2 screen = camera.PointToScreenNormal(targetPosition);
		bool isInFront = (targetPosition - camera.WorldPosition).Dot(camera.WorldRotation.Forward) > 0f;
		Vector2 offset = new Vector2(screen.x - 0.5f, screen.y - 0.5f);
		if (!isInFront)
		{
			offset = -offset;
		}

		bool isOnScreen = isInFront && System.MathF.Abs(offset.x) <= MarkerEdgeX && System.MathF.Abs(offset.y) <= MarkerEdgeY;
		if (isOnScreen)
		{
			_markerPosition = new Vector2(screen.x, screen.y - 0.07f);
			_arrowAngle = 90f;
			return;
		}

		float scale = System.MathF.Max(System.MathF.Abs(offset.x) / MarkerEdgeX, System.MathF.Abs(offset.y) / MarkerEdgeY);
		if (scale < 0.0001f)
		{
			scale = 1f;
		}

		_markerPosition = new Vector2(0.5f + offset.x / scale, 0.5f + offset.y / scale);
		_arrowAngle = System.MathF.Atan2(offset.y, offset.x) * 180f / System.MathF.PI;
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			value1: _isVisible,
			value2: (int)(_markerPosition.x * 500f),
			value3: (int)(_markerPosition.y * 500f),
			value4: (int)_arrowAngle / 2,
			value5: _distance,
			value6: _label,
			value7: ReviveFlare
		);
	}
}
