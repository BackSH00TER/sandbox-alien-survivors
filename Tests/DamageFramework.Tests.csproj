<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EngineDirectory Condition="'$(EngineDirectory)' == ''">$(FACEPUNCH_ENGINE)</EngineDirectory>
  </PropertyGroup>
  <Target Name="CheckEngine" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(EngineDirectory)\bin\managed\Sandbox.System.dll')" Text="Set FACEPUNCH_ENGINE or pass -p:EngineDirectory to your s&amp;box installation." />
  </Target>
  <ItemGroup>
    <None Include="..\Assets\prefabs\game_enemy*.prefab" Link="EnemyPrefabs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\scenes\game.scene" Link="EnemyPrefabs\game.scene" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Code\game\DamageEffect.cs" Link="DamageEffect.cs" />
    <Compile Include="..\Code\game\DamageEffectChain.cs" Link="DamageEffectChain.cs" />
    <Compile Include="..\Code\game\enemies\EnemyAggro.cs" Link="EnemyAggro.cs" />
    <Compile Include="..\Code\game\ExperienceOrbRules.cs" Link="ExperienceOrbRules.cs" />
    <Compile Include="..\Code\game\TimedDamageEffects.cs" Link="TimedDamageEffects.cs" />
    <Compile Include="..\Code\game\WeightedDraw.cs" Link="WeightedDraw.cs" />
    <Compile Include="..\Code\game\GameRarity.cs" Link="GameRarity.cs" />
    <Compile Include="..\Code\game\GameModifier.cs" Link="GameModifier.cs" />
    <Compile Include="..\Code\game\GameShotModifiers.cs" Link="GameShotModifiers.cs" />
    <Compile Include="..\Code\game\GameTimelineEvent.cs" Link="GameTimelineEvent.cs" />
    <Compile Include="..\Code\game\events\GameEventCatalog.cs" Link="GameEventCatalog.cs" />
    <Compile Include="..\Code\game\events\GameFogTiming.cs" Link="GameFogTiming.cs" />
    <Compile Include="..\Code\game\events\GameFogDrift.cs" Link="GameFogDrift.cs" />
    <Compile Include="..\Code\game\GameLootDrop.cs" Link="GameLootDrop.cs" />
    <Compile Include="..\Code\game\GameLootCatalog.cs" Link="GameLootCatalog.cs" />
    <Compile Include="..\Code\game\stats\GameDamageType.cs" Link="GameDamageType.cs" />
    <Compile Include="..\Code\game\stats\GameEnemyKind.cs" Link="GameEnemyKind.cs" />
    <Compile Include="..\Code\game\stats\GameStatKeys.cs" Link="GameStatKeys.cs" />
    <Compile Include="..\Code\game\stats\GameStatCatalog.cs" Link="GameStatCatalog.cs" />
    <Compile Include="..\Code\game\stats\GameStatHistory.cs" Link="GameStatHistory.cs" />
    <Reference Include="$(EngineDirectory)\bin\managed\Sandbox.System.dll" />
  </ItemGroup>
</Project>
